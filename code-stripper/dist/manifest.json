{
  "manifest_version": 3,
  "name": "CodeStripper: Technical Tutorial Distiller",
  "version": "2.0.0",
  "description": "Strips narrative fluff from technical tutorials and extracts compile-ready code snippets, configs, and project skeletons (.zip).",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open CodeStripper (Alt+Shift+C)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "commands": {
    "toggle-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Toggle CodeStripper Side Panel"
    }
  },
  "content_scripts": [
    {
      "js": [
        "assets/extractor.ts-loader-Djr8GexK.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/extractor-C-1sj-GM.js",
        "assets/classifier-GJWVOA2z.js",
        "assets/src-content-extractor.ts-gFhR2H-6.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
