# ==============================================================================
# Chrome Extensions Monorepo - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in relevant sub-packages when local overrides are needed.
# Note: All extensions and apps operate 100% locally with zero cloud dependencies.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Webhook Inspector Companion Receiver (Optional local hook test listener)
COMPANION_PORT=9999
COMPANION_HOST=127.0.0.1

# Statement2Ledger Offline Web App (Local Vite dev server)
VITE_DEV_PORT=5173
VITE_BASE_URL=http://localhost:5173

# CodeStripper Dev Server
CODESTRIPPER_DEV_PORT=5174
